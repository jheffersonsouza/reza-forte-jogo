[gd_scene format=3]

[ext_resource type="Texture2D" path="res://assets/art/background.svg" id="1_bg"]
[ext_resource type="Script" path="res://scripts/scene_button.gd" id="2_button"]

[node name="Intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("1_bg")
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Speaker" type="Label" parent="Center/Panel/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.81, 0.54, 1)
theme_override_font_sizes/font_size = 28
text = "Vó Toinha, a rezadeira"

[node name="Speech" type="Label" parent="Center/Panel/Column"]
custom_minimum_size = Vector2(760, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "— Menino, vem cá pra perto da vela. Tá ouvindo esse arranhado na parede? É visagem, e ela sabe teu nome.

Não te avexa não. Essa reza minha mãe rezava nos tempos da seca e nunca falhou. Eu vou mostrando os objetos sagrados, um por um: a arruda, o sal grosso, o terço e a vela de carnaúba. Tu repete na mesma ordem, sem errar nenhum.

A cada volta a reza cresce. Se tu aguentar até o galo cantar, ela vai embora. Se errar... a porta se abre."
autowrap_mode = 3

[node name="ReadyButton" type="Button" parent="Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Tô pronto, vó"
script = ExtResource("2_button")
target_scene = "res://scenes/game.tscn"
autofocus = true
