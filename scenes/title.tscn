[gd_scene format=3]

[ext_resource type="Texture2D" path="res://assets/art/background.svg" id="1_bg"]
[ext_resource type="Script" path="res://scripts/scene_button.gd" id="2_button"]
[ext_resource type="Script" path="res://scripts/title.gd" id="3_title"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_title")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("1_bg")
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="GameName" type="Label" parent="Center/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.81, 0.54, 1)
theme_override_font_sizes/font_size = 84
text = "Reza Forte"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Center/Column"]
layout_mode = 2
text = "Uma noite cabulosa no sertão do Ceará"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Center/Column"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2

[node name="StartButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Começar"
script = ExtResource("2_button")
target_scene = "res://scenes/intro.tscn"
autofocus = true

[node name="QuitButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Sair"
