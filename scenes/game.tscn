[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game.gd" id="1_game"]
[ext_resource type="Texture2D" path="res://assets/art/background.webp" id="2_bg"]
[ext_resource type="Texture2D" path="res://assets/art/arruda.webp" id="3_arruda"]
[ext_resource type="Texture2D" path="res://assets/art/sal_grosso.webp" id="4_sal_grosso"]
[ext_resource type="Texture2D" path="res://assets/art/terco.webp" id="5_terco"]
[ext_resource type="Texture2D" path="res://assets/art/vela.webp" id="6_vela"]

[node name="Game" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_game")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
expand_mode = 1
stretch_mode = 6

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 72
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 72

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RoundLabel" type="Label" parent="Layout/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1

[node name="TurnLabel" type="Label" parent="Layout/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.81, 0.54, 1)
theme_override_font_sizes/font_size = 36
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Layout/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="Objects" type="HBoxContainer" parent="Layout/Column"]
layout_mode = 2
theme_override_constants/separation = 56
alignment = 1

[node name="Arruda" type="TextureButton" parent="Layout/Column/Objects"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 180)
layout_mode = 2
tooltip_text = "Afasta mau-olhado e espíritos ruins"
texture_normal = ExtResource("3_arruda")
ignore_texture_size = true
stretch_mode = 5

[node name="Name" type="Label" parent="Layout/Column/Objects/Arruda"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -20.0
offset_top = 6.0
offset_right = 20.0
offset_bottom = 40.0
grow_horizontal = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 20
text = "[1] Ramo de arruda"
horizontal_alignment = 1

